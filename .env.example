# docker-compose.yml용 환경변수. 복사해서 .env로 저장 후 값을 채우세요.
#   cp .env.example .env

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 에이전트를 docker-compose 내부 네트워크(서비스명 web)로 테스트할 때만 "web" 추가 필요.
# 실제 원격 에이전트가 쓰는 도메인/IP는 여기에 반드시 추가할 것.
#
# 운영 배포 시 반드시 TLS 종료 리버스 프록시(nginx/Caddy 등)를 web 컨테이너 앞에 둘 것 —
# 이 compose 파일은 web을 평문 HTTP(8000)로만 노출하며, 에이전트 토큰과 점검 결과가
# 그대로 네트워크에 노출된다(adversarial review 지적). 에이전트 --server는 https://로 설정.

# PostgreSQL
POSTGRES_DB=vulnchecker
POSTGRES_USER=vulnchecker
POSTGRES_PASSWORD=change-me

# CheckResult.detail 저장 시 암호화(Phase 6). 반드시 새로 생성해서 바꿀 것:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 운영 배포 후 이 키를 바꾸면 기존 암호화된 detail은 복호화 실패 → 평문 폴백 경고가 뜬다
# (레거시 호환 동작이지 버그 아님 — monitor/fields.py 참고).
FIELD_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

# Grafana (메트릭 그래프 전용 — 읽기 전용으로 Postgres 조회)
GRAFANA_ADMIN_PASSWORD=change-me
# db 컨테이너에서 최초 1회 CREATE ROLE grafana_reader로 만들 비밀번호와 동일하게 맞출 것
GRAFANA_DB_READER_PASSWORD=change-me
